                {
                  "atomType": "Code",
                  "x": 0.2,
                  "y": 0.5,
                  "uniqueID": "id-237",
                  "interpreterVersion": 1,
                  "code": "/**\n * Headstock outline traced from the reference photo, in mm.\n * The neck centre line is X = 0; the guitar points along +Y.\n */\nconst POINTS: number[][] = [\n  [23.1, 326.3], [25.5, 331.3], [28.5, 335.9], [31.1, 340.8], [34.9, 344.8], [38.9, 348.7],\n  [43.2, 352.1], [46.9, 356.1], [47.1, 361.3], [45.7, 366.6], [45.0, 372.1], [44.1, 377.4],\n  [43.0, 382.8], [42.4, 388.0], [41.3, 393.3], [40.0, 398.7], [38.8, 404.0], [38.4, 409.5],\n  [37.2, 414.9], [36.6, 420.3], [35.9, 425.7], [35.1, 431.1], [34.6, 436.5], [36.9, 441.5],\n  [40.8, 445.5], [43.7, 450.1], [43.6, 455.4], [42.7, 460.7], [43.3, 466.0], [42.5, 471.5],\n  [41.2, 476.8], [38.6, 481.6], [35.4, 486.2], [32.3, 490.7], [28.3, 494.6], [23.5, 497.2],\n  [18.2, 498.5], [14.4, 494.8], [10.2, 491.3], [8.9, 486.0], [6.9, 480.8], [5.7, 475.5],\n  [3.8, 470.3], [1.6, 465.3], [0.3, 459.9], [-1.2, 454.7], [-2.6, 449.4], [-4.4, 444.2],\n  [-5.7, 438.9], [-7.0, 433.6], [-8.9, 428.4], [-10.6, 423.1], [-12.0, 417.8], [-13.4, 412.5],\n  [-14.9, 407.3], [-16.5, 402.1], [-17.9, 396.8], [-19.2, 391.4], [-21.6, 386.4], [-22.9, 381.1],\n  [-24.2, 375.8], [-26.1, 370.6], [-27.5, 365.3], [-29.8, 360.3], [-31.3, 355.0], [-32.5, 349.6],\n  [-34.1, 344.3], [-32.9, 339.1], [-29.0, 335.2], [-25.9, 330.6], [-22.6, 326.2], [-18.9, 322.4],\n  [-13.5, 321.7], [-7.9, 321.7], [-2.4, 321.7], [3.2, 321.7], [8.7, 321.7], [14.3, 321.7],\n  [19.8, 322.0]\n];\n\nfunction run(): Assembly {\n  const n = POINTS.length;\n  const p = (i: number) => POINTS[(i + n) % n];\n  // Closed Catmull-Rom spline through the traced points, drawn as cubic Beziers\n  let pen = replicad.draw(p(0));\n  for (let i = 0; i < n; i++) {\n    const [a, b, c, d] = [p(i - 1), p(i), p(i + 1), p(i + 2)];\n    const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];\n    const c2 = [c[0] - (d[0] - b[0]) / 6, c[1] - (d[1] - b[1]) / 6];\n    pen = pen.cubicBezierCurveTo(c, c1, c2);\n  }\n  return new Assembly({ geometry: pen.close() });\n}\n",
                  "compiledCode": "\"use strict\";\n/**\n * Headstock outline traced from the reference photo, in mm.\n * The neck centre line is X = 0; the guitar points along +Y.\n */\nconst POINTS = [\n    [23.1, 326.3], [25.5, 331.3], [28.5, 335.9], [31.1, 340.8], [34.9, 344.8], [38.9, 348.7],\n    [43.2, 352.1], [46.9, 356.1], [47.1, 361.3], [45.7, 366.6], [45.0, 372.1], [44.1, 377.4],\n    [43.0, 382.8], [42.4, 388.0], [41.3, 393.3], [40.0, 398.7], [38.8, 404.0], [38.4, 409.5],\n    [37.2, 414.9], [36.6, 420.3], [35.9, 425.7], [35.1, 431.1], [34.6, 436.5], [36.9, 441.5],\n    [40.8, 445.5], [43.7, 450.1], [43.6, 455.4], [42.7, 460.7], [43.3, 466.0], [42.5, 471.5],\n    [41.2, 476.8], [38.6, 481.6], [35.4, 486.2], [32.3, 490.7], [28.3, 494.6], [23.5, 497.2],\n    [18.2, 498.5], [14.4, 494.8], [10.2, 491.3], [8.9, 486.0], [6.9, 480.8], [5.7, 475.5],\n    [3.8, 470.3], [1.6, 465.3], [0.3, 459.9], [-1.2, 454.7], [-2.6, 449.4], [-4.4, 444.2],\n    [-5.7, 438.9], [-7.0, 433.6], [-8.9, 428.4], [-10.6, 423.1], [-12.0, 417.8], [-13.4, 412.5],\n    [-14.9, 407.3], [-16.5, 402.1], [-17.9, 396.8], [-19.2, 391.4], [-21.6, 386.4], [-22.9, 381.1],\n    [-24.2, 375.8], [-26.1, 370.6], [-27.5, 365.3], [-29.8, 360.3], [-31.3, 355.0], [-32.5, 349.6],\n    [-34.1, 344.3], [-32.9, 339.1], [-29.0, 335.2], [-25.9, 330.6], [-22.6, 326.2], [-18.9, 322.4],\n    [-13.5, 321.7], [-7.9, 321.7], [-2.4, 321.7], [3.2, 321.7], [8.7, 321.7], [14.3, 321.7],\n    [19.8, 322.0]\n];\nfunction run() {\n    const n = POINTS.length;\n    const p = (i) => POINTS[(i + n) % n];\n    // Closed Catmull-Rom spline through the traced points, drawn as cubic Beziers\n    let pen = replicad.draw(p(0));\n    for (let i = 0; i < n; i++) {\n        const [a, b, c, d] = [p(i - 1), p(i), p(i + 1), p(i + 2)];\n        const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];\n        const c2 = [c[0] - (d[0] - b[0]) / 6, c[1] - (d[1] - b[1]) / 6];\n        pen = pen.cubicBezierCurveTo(c, c1, c2);\n    }\n    return new Assembly({ geometry: pen.close() });\n}\n"
